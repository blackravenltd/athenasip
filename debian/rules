#!/usr/bin/make -f
#
# AthenaSIP - Secure, Minimal, Cloud-Native SIP Server
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the GNU GPLv3 - see <https://www.gnu.org/licenses/gpl-3.0.html>
#
# Built on Debian's own Boost, as the rest of the stack is; Boost.MQTT5, newer than it, is vendored in
# third_party/boost-mqtt5. The package depends only on what Debian ships.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DATHENA_SYSTEMD_UNIT_DIR=/usr/lib/systemd/system

# The unit suite is a build of its own (tools/ci.sh release), run before a release rather than here.
override_dh_auto_test:

# The maintainer scripts leave a new install stopped and restart a node that was running.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade --no-restart-after-upgrade
