#
# The node docker-compose.yml runs, rendered by docker/up.sh. Hosts are compose service
# names, except @PUBLIC_ADDRESS@, the host's, which clients must be able to reach.
#

sip:
  node_id: athenasip-quickstart
  public_address: @PUBLIC_ADDRESS@
  allow_unencrypted: true         # plain UDP and TCP, for any softphone

udp:
  enable: true
  address: 0.0.0.0
  port: @SIP_PORT@

tcp:
  enable: true
  address: 0.0.0.0
  port: @SIP_PORT@

tls:
  enable: true
  address: 0.0.0.0
  port: @TLS_PORT@
  cert_pem_filename: "/tls/snakeoil.cer"   # trust tls/ca/snakeca.crt, or click through
  key_pem_filename: "/tls/snakeoil.key"

websocket:
  enable: true
  address: 0.0.0.0
  port: @WSS_PORT@
  tls: true
  cert_pem_filename: "/tls/snakeoil.cer"
  key_pem_filename: "/tls/snakeoil.key"

datastore:
  url: "redis://redis:6379"

events:
  url: "mqtt://mosquitto:1883/?prefix=athenasip/"
  status_interval: 30

media:
  url: "rtpengine://@RTPENGINE_ADDRESS@:22222"   # browsers need WebRTC, which builtin cannot do
  rtpengine:
    timeout_ms: 500
    attempts: 3

http:
  address: 0.0.0.0
  port: @API_PORT@
  api:
    enable: true                  # up.sh makes the first admin with athenasip --add-user
    session_lifetime: 43200
    session_idle: 3600
    ice_servers:
      - url: "stun:@PUBLIC_ADDRESS@:3478"
      - url: "turn:@PUBLIC_ADDRESS@:3478"
    turn_shared_secret: "change-me-turn-secret"   # must match docker/turnserver.conf; change both
    turn_credential_ttl: 3600
  files:
    enable: @SERVE_CONSOLE@       # true once the console has been built
    path: "/console"
    spa: true
