#
# The node that docker-compose.yml runs, on the canonical backends: Redis, Mosquitto
# and rtpengine. docker/up.sh renders this file.
#
# Addresses are container names on the compose network, except sip.public_address,
# which up.sh takes from the host so that clients can reach it.

sip:
  node_id: athenasip-quickstart

  # Written into Via and Record-Route. A container's own address is unreachable from
  # outside the compose network.
  public_address: @PUBLIC_ADDRESS@

  # Plain UDP and TCP are open so that any softphone can connect. On a hostile network,
  # turn this off and serve TLS and WSS only.
  allow_unencrypted: true

udp:
  enable: true
  address: 0.0.0.0
  port: @SIP_PORT@

tcp:
  enable: true
  address: 0.0.0.0
  port: @SIP_PORT@

tls:
  enable: true
  address: 0.0.0.0
  port: @TLS_PORT@
  cert_pem_filename: "/tls/snakeoil.cer"
  key_pem_filename: "/tls/snakeoil.key"

# WSS, which a browser on an https page requires. The certificate is the snakeoil one:
# trust tls/ca/snakeca.crt or click through - see docs/quick_start.md.
websocket:
  enable: true
  address: 0.0.0.0
  port: @WSS_PORT@
  tls: true
  cert_pem_filename: "/tls/snakeoil.cer"
  key_pem_filename: "/tls/snakeoil.key"

datastore:
  # Registrations, realms, subscribers, users and sessions, kept across a node restart.
  url: "redis://redis:6379"

events:
  # Observability, presence and discovery; never on the call setup path.
  url: "mqtt://mosquitto:1883/?prefix=athenasip/"
  status_interval: 30

media:
  # rtpengine, because browser media is WebRTC and the builtin relay is plain RTP only.
  url: "rtpengine://@RTPENGINE_ADDRESS@:22222"

  rtpengine:
    timeout_ms: 500
    attempts: 3

http:
  address: 0.0.0.0
  port: @API_PORT@

  api:
    enable: true

    # No tokens: API callers sign in as users. docker/up.sh creates the first
    # administrator with `athenasip --add-user` inside the container.

    session_lifetime: 43200
    session_idle: 3600

    # Handed to web clients by GET /api/v1/subscriber/{realm}/config: the coturn in this stack, at
    # the host's address.
    ice_servers:
      - url: "stun:@PUBLIC_ADDRESS@:3478"
      - url: "turn:@PUBLIC_ADDRESS@:3478"

    # Must match static-auth-secret in docker/turnserver.conf. Change both before this
    # is reachable from anywhere you do not control.
    turn_shared_secret: "change-me-turn-secret"
    turn_credential_ttl: 3600

  # The admin console, mounted here when it has been built; otherwise nothing is served.
  files:
    enable: @SERVE_CONSOLE@
    path: "/console"
    spa: true
