#
# sipp from Debian's package, plus curl, which the harness uses to provision over the
# admin API.

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        sip-tester \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /e2e

ENTRYPOINT ["sipp"]
