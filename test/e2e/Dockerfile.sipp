#
# sipp, from Debian's own package rather than a registry image nobody in this project
# controls. curl comes with it because the harness provisions over the admin API before
# it makes a call.

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        sip-tester \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /e2e

ENTRYPOINT ["sipp"]
