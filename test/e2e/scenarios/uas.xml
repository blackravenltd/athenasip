<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  The callee: 180 then 200 to the INVITE, and 200 to the BYE. run.sh registers it first,
  in a run of its own. Ringing before answering (RFC 3261 13.3.1) is what creates the early
  dialog.
-->
<scenario name="Callee: ring, answer, hang up">

  <!-- No REGISTER here: sipp binds a scenario to one call and would discard the INVITE,
       which arrives with the caller's Call-ID. run.sh registers the callee in a run of its
       own, on the port this one listens on. -->

  <recv request="INVITE" crlf="true">
    <action>
      <!-- RFC 3261 16.6 step 4: the node Record-Routes itself, so the BYE returns through it. -->
      <ereg regexp="lr" search_in="hdr" header="Record-Route:" check_it="true" assign_to="route"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=uas-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="200"/>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=uas-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=callee 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000

    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true"/>

  <recv request="BYE"/>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <Reference variables="route"/>

</scenario>
