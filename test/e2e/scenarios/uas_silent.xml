<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  A callee that never answers, which makes the node's timer B observable. run.sh registers
  it first, so the INVITE is forwarded and retransmitted.
-->
<scenario name="Callee: never answers">

  <!-- No REGISTER here: sipp binds a scenario to one call and would discard the INVITE,
       which arrives with the caller's Call-ID. run.sh registers the callee in a run of its
       own, on the port this one listens on. -->

  <!-- The INVITE is left unanswered. The node retransmits it (RFC 3261 17.1.1.2, timer A)
       and gives up at timer B. -->
  <recv request="INVITE" crlf="true"/>

  <pause milliseconds="40000"/>

</scenario>
