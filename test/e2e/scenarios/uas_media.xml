<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  The callee's half of the media test. The description that reaches the callee must name
  the node's relay in c= (RFC 8866 section 5.7), not the caller, or the call was not
  anchored.
-->
<scenario name="Callee: media is anchored at the node">

  <!-- No REGISTER here: sipp binds a scenario to one call and would discard the INVITE,
       which arrives with the caller's Call-ID. run.sh registers the callee in a run of its
       own, on the port this one listens on. -->

  <recv request="INVITE" crlf="true">
    <action>
      <!-- The relay's address, from the node's own configuration. -->
      <ereg regexp="c=IN IP4 172.31.0.10" search_in="body" check_it="true" assign_to="anchored"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=uas-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=uas-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=callee 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000

    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true"/>

  <!-- Echo media back, so the caller's stream returns through the relay. -->
  <pause milliseconds="3000"/>

  <recv request="BYE"/>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <Reference variables="anchored"/>

</scenario>
