<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  The callee's half of the media test. The point of the assertion below: the description
  that reaches the callee names the node's relay, not the caller. If the caller's own
  address arrives here, the media engine did not anchor the call and the two ends are
  talking to each other directly - which works on one LAN and never works for a browser.

  RFC 8866 section 5.7: c= is where media goes.
-->
<scenario name="Callee: media is anchored at the node">

  <!--
    No REGISTER here, deliberately. sipp binds a scenario to a single call, so a callee
    that registered in this scenario could not then be handed the INVITE: it arrives with
    the caller's Call-ID, sipp cannot map it to the call already running, and discards it
    as unmappable. run.sh registers the callee in a run of its own, on the port this one
    then listens on, so the binding points here.
  -->

  <recv request="INVITE" crlf="true">
    <action>
      <!-- The relay's address, from the node's own configuration. -->
      <ereg regexp="c=IN IP4 172.31.0.10" search_in="body" check_it="true" assign_to="anchored"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=callee 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000

    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true"/>

  <!-- Echo whatever arrives back where it came from, so the caller can hear its own
       stream return through the relay. -->
  <pause milliseconds="3000"/>

  <recv request="BYE"/>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <Reference variables="anchored"/>

</scenario>
