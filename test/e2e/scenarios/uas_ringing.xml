<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  A callee that rings and never answers, for the CANCEL cases. RFC 3261 9.2: the CANCEL is
  answered 200 and the INVITE it cancels 487.
-->
<scenario name="Callee: rings, is cancelled">

  <!-- No REGISTER here: sipp binds a scenario to one call and would discard the INVITE,
       which arrives with the caller's Call-ID. run.sh registers the callee in a run of its
       own, on the port this one listens on. -->

  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=uas-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <recv request="CANCEL"/>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- RFC 3261 9.2: the INVITE the CANCEL applied to ends 487, not 200. -->
  <send retrans="500">
    <![CDATA[

      SIP/2.0 487 Request Terminated
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      CSeq: [cseq] INVITE
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" crlf="true"/>

</scenario>
