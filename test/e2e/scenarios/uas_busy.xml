<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  RFC 3261 21.4.24: a busy callee answers 486, and the proxy passes that final answer back
  to the caller.
-->
<scenario name="Callee: busy">

  <!-- No REGISTER here: sipp binds a scenario to one call and would discard the INVITE,
       which arrives with the caller's Call-ID. run.sh registers the callee in a run of its
       own, on the port this one listens on. -->

  <recv request="INVITE" crlf="true"/>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 486 Busy Here
      [last_Via:]
      [last_From:]
      [last_To:];tag=uas-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" crlf="true"/>

</scenario>
