#
# The node a SIP client is pointed at. Everything is in-process: no Redis, no broker.
#
# Rendered by up.sh, which supplies the ports. They default to those AthenaPhone's
# harness uses for its Asterisk fixture, and can be moved to run both at once.
#
# The container binds the port numbers the host publishes: the node writes its own port
# into Via and Record-Route.

sip:
  node_id: interop-node

  # The host address the client reaches the published ports on, written into Via and
  # Record-Route.
  public_address: @PUBLIC_ADDRESS@

  # UDP, TCP and WS are the point of this fixture. A client using TLS verifies against
  # tls/ca/snakeca.crt.
  allow_unencrypted: true

  # Log whole messages, bodies included; credentials are redacted.
  # ATHENA_INTEROP_LOG_MESSAGES=false turns it off.
  log_messages: @LOG_MESSAGES@

  connect_timeout_ms: 4000

udp:
  enable: true
  address: 0.0.0.0
  port: @SIP_PORT@

tcp:
  enable: true
  address: 0.0.0.0
  port: @SIP_PORT@

tls:
  enable: true
  address: 0.0.0.0
  port: @TLS_PORT@
  cert_pem_filename: "/tls/snakeoil.cer"
  key_pem_filename: "/tls/snakeoil.key"

# Plain ws only, on the port Asterisk serves ws on.
websocket:
  enable: true
  address: 0.0.0.0
  port: @WS_PORT@
  tls: false

datastore:
  url: "memory://"

events:
  url: "local://"

# Both drivers are configured; only the one the URL selects reads its section.
#
# builtin:// is plain RTP, which an ordinary softphone on UDP, TCP or TLS expects. A
# WebRTC client needs rtpengine, which up.sh --rtpengine selects.
media:
  url: "@MEDIA_URL@"

  builtin:
    bind_address: 0.0.0.0
    public_address: @PUBLIC_ADDRESS@
    port_min: @RTP_MIN@
    port_max: @RTP_MAX@

  rtpengine:
    # The engine is on the same bridge, so this only bounds silence.
    timeout_ms: 500
    attempts: 3

http:
  address: 0.0.0.0
  port: @API_PORT@

  api:
    enable: true
    # No tokens: up.sh and the browser spec sign in as the fixture's user, which the node
    # creates as it starts (docker-compose.yml).

    # ICE servers for GET /api/v1/client/config. Rendered by up.sh: empty unless coturn is
    # in the fixture.
@ICE_SERVERS@
    turn_shared_secret: "@TURN_SECRET@"
    turn_credential_ttl: 600

  # The admin client, whose softphone is the browser test's page. Mounted by up.sh.
  files:
    enable: @FILES_ENABLE@
    path: "/admin"
