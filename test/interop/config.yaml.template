#
# The node a SIP client is pointed at to see whether the two agree. Everything is
# in-process: nothing here is testing Redis or a broker, and a fixture that needs them
# is a fixture that fails for reasons that have nothing to do with SIP.
#
# Rendered by up.sh, which is where the ports come from. They default to the ones
# AthenaPhone's integration harness already uses for its Asterisk fixture, so pointing
# that harness here is a host and a CA rather than a rewrite, and they can be moved so
# that both fixtures run at once.
#
# The container binds the same number the host publishes. A node writes its own local
# port into Via and Record-Route, so a mapping that translated the port would tell a
# client to come back to one nothing is listening on.

sip:
  node_id: interop-node

  # The client runs on the host and reaches the container through published ports, so
  # this is the address it can actually come back to. Without it the node writes the
  # container's own address into Via and Record-Route and nothing routes.
  public_address: @PUBLIC_ADDRESS@

  # UDP, TCP and WS are the point of this fixture. TLS is here too, and a client that
  # wants it verifies against tls/ca/snakeca.crt.
  allow_unencrypted: true

  # The whole of every message, bodies included, because this fixture exists to find out
  # why a client and this node disagree and the session description is usually the
  # answer. Credentials are redacted. ATHENA_INTEROP_LOG_MESSAGES=false turns it off.
  log_messages: @LOG_MESSAGES@

  # Long enough that a registration does not lapse mid-test, short enough that a stale
  # one does not outlive the container.
  connect_timeout_ms: 4000

udp:
  enable: true
  address: 0.0.0.0
  port: @SIP_PORT@

tcp:
  enable: true
  address: 0.0.0.0
  port: @SIP_PORT@

tls:
  enable: true
  address: 0.0.0.0
  port: @TLS_PORT@
  cert_pem_filename: "/tls/snakeoil.cer"
  key_pem_filename: "/tls/snakeoil.key"

# One WebSocket listener, plain, on the port Asterisk serves ws on. A node has one
# websocket section, so it is ws or wss and not both; this fixture is the signalling
# one, and a client that cannot be given a CA cannot verify wss anyway.
websocket:
  enable: true
  address: 0.0.0.0
  port: @WS_PORT@
  tls: false

datastore:
  url: "memory://"

events:
  url: "local://"

# Which engine is on the media path. Both drivers are configured whichever it is: a
# plugin reads its own YAML root, so the one that was not selected reads nothing.
#
# builtin:// is the in-process relay and plain RTP, which is what an ordinary SIP
# softphone on UDP, TCP or TLS expects. A client whose media is WebRTC will register
# and signal cleanly against it and fail to agree on media, which is the honest result
# rather than one arranged by configuration - and rtpengine, which up.sh --rtpengine
# selects, is the answer to it.
media:
  url: "@MEDIA_URL@"

  builtin:
    bind_address: 0.0.0.0
    public_address: @PUBLIC_ADDRESS@
    port_min: @RTP_MIN@
    port_max: @RTP_MAX@

  rtpengine:
    # The engine is a container away on a bridge and answers in microseconds, so this
    # is a bound on silence rather than on work.
    timeout_ms: 500
    attempts: 3

http:
  address: 0.0.0.0
  port: @API_PORT@

  api:
    enable: true
    tokens:
      - token: "interop-admin"
        scopes: [admin]
      - token: "interop-client"
        scopes: [client]

  # The admin client, which is also the harness's browser page: a softphone this node
  # serves itself, so a browser test needs no second web server and no CORS. The
  # directory is mounted by up.sh and is empty of this node's concern otherwise.
  files:
    enable: @FILES_ENABLE@
    path: "/admin"
