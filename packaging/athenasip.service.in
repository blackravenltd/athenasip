#
# AthenaSIP - Secure, Minimal, Cloud-Native SIP Server
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the GNU GPLv3 – see <https://www.gnu.org/licenses/gpl-3.0.html>
#
# A SIP server is a thing on a network that strangers can send bytes to, so this unit
# assumes it will one day be the way in. It runs as its own unprivileged user, can
# write to exactly two directories, and can reach nothing else on the host.
#
# Nothing here needs a privileged port: SIP is 5060 and 5061, both above 1024.
#
# Generated by CMake from packaging/athenasip.service.in - edit that, not the installed
# copy, and edit the installed copy with "systemctl edit athenasip" rather than in place.

[Unit]
Description=AthenaSIP - secure, minimal, cloud-native SIP server
Documentation=https://github.com/blackravenltd/athenasip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/athenasip --config @ATHENA_CONFIG_INSTALL_DIR@/config.yaml

User=athenasip
Group=athenasip

# /var/lib/athenasip and /var/log/athenasip, created and chowned by systemd. The node
# needs no other writable path.
StateDirectory=athenasip
StateDirectoryMode=0750
LogsDirectory=athenasip
LogsDirectoryMode=0750
ConfigurationDirectory=athenasip
ConfigurationDirectoryMode=0750

Restart=on-failure
RestartSec=5s

# Enough to answer, not enough to be the reason a shared host fell over. A SIP server
# holds a few hundred bytes per registration and a few kilobytes per call; the limits
# are generous for that and still a ceiling.
MemoryMax=512M
TasksMax=256
LimitNOFILE=16384

# Hardening. Everything here is off unless the node is known to need it, which for a
# process that reads one file and opens sockets is nearly everything.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077

# It talks IP and nothing else. No unix sockets to other daemons, no netlink, no
# packet sockets.
RestrictAddressFamilies=AF_INET AF_INET6

# No capabilities at all. A privileged port would need CAP_NET_BIND_SERVICE, and the
# answer to wanting one is to put a proxy in front rather than to give this one root's
# ability to bind it.
CapabilityBoundingSet=
AmbientCapabilities=

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @raw-io
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
