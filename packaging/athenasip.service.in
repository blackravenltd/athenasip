#
# AthenaSIP - Secure, Minimal, Cloud-Native SIP Server
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the GNU GPLv3 – see <https://www.gnu.org/licenses/gpl-3.0.html>
#
# Runs the node as its own unprivileged user, able to write only its state and log
# directories. No privileged port is needed: SIP is 5060 and 5061.
#
# Generated by CMake from packaging/athenasip.service.in. Customise an installed unit
# with "systemctl edit athenasip", not in place.

[Unit]
Description=AthenaSIP - secure, minimal, cloud-native SIP server
Documentation=https://github.com/blackravenltd/athenasip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/athenasip --config @ATHENA_CONFIG_INSTALL_DIR@/config.yaml

User=athenasip
Group=athenasip

# /var/lib/athenasip and /var/log/athenasip, created and owned by systemd. The node
# writes nowhere else.
StateDirectory=athenasip
StateDirectoryMode=0750
LogsDirectory=athenasip
LogsDirectoryMode=0750
ConfigurationDirectory=athenasip
ConfigurationDirectoryMode=0750

Restart=on-failure
RestartSec=5s

# Ceilings that protect a shared host. A node holds a few hundred bytes per
# registration and a few kilobytes per call.
MemoryMax=512M
TasksMax=256
LimitNOFILE=16384

# Hardening: the node reads one file and opens sockets, so everything else is denied.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077

# IP only: no unix, netlink or packet sockets.
RestrictAddressFamilies=AF_INET AF_INET6

# No capabilities. To serve a privileged port, put a proxy in front.
CapabilityBoundingSet=
AmbientCapabilities=

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @raw-io
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
