# A node being removed stops; one being upgraded keeps running until postinst restarts it.

set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
  systemctl disable --now athenasip >/dev/null 2>&1 || true
fi

exit 0
